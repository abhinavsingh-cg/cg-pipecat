# ── Component selection ─────────────────────────────────────────────────────
# STT_PRIMARY:   sarvam | deepgram | credgenics_http
# LLM_VENDOR:    groq   | openai   | bedrock | sarvam
# TTS_VENDOR:    sarvam | elevenlabs | cartesia
STT_PRIMARY=sarvam
LLM_VENDOR=groq
TTS_VENDOR=sarvam

# Default language at session start (one of the keys in SUPPORTED_LNG_SUFFIX)
DEFAULT_LANGUAGE=hindi
LANG_SWITCH_THRESHOLD=2

# ── Vendor API keys (fill in only the ones for the components you selected) ─
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ELEVEN_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
AWS_BEDROCK_API_KEY=
AWS_BEDROCK_REGION=us-east-1
SARVAM_LLM_API_KEY=

# ── In-house Credgenics HTTP STT (only when STT_PRIMARY=credgenics_http) ────
STT_BASE_URL=
STT_TIMEOUT_S=4

# ── LLM model + tuning ──────────────────────────────────────────────────────
LLM_MODEL=llama-3.1-70b-versatile
LLM_TIMEOUT_S=1.5
MAX_LLM_RETRIES=2

# ── Sarvam TTS defaults ─────────────────────────────────────────────────────
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_PACE=1.10
SARVAM_TTS_TEMPERATURE=0.6

# ── STT defaults ────────────────────────────────────────────────────────────
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_SAMPLE_RATE=16000
DEEPGRAM_STT_MODEL=nova-2

# ── VAD / endpointing (Pipecat-native) ──────────────────────────────────────
VAD_MIN_SILENCE_MS=800
VAD_MIN_SPEECH_MS=150
VAD_CONFIDENCE=0.9

# ── Idle prompts + early barge-in ───────────────────────────────────────────
ARE_YOU_THERE_TIMEOUT=8
ARE_YOU_THERE_MAX_STRIKES=3
EARLY_BARGE_IN_WINDOW_S=0.8

# ── Redis conversation memory ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CONTEXT_EXPIRY_SECONDS=86400

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=voicebot

# ── Local dev WebRTC server ─────────────────────────────────────────────────
WEBRTC_HOST=127.0.0.1
WEBRTC_PORT=7860
